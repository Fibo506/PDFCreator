<Window x:Class="pdfforge.PDFCreator.UI.Presentation.Windows.ProfessionalFeatureInteractions.BusinessFeaturesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:designTime="clr-namespace:pdfforge.PDFCreator.UI.Presentation.DesignTime"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:utilities="clr-namespace:pdfforge.PDFCreator.Utilities;assembly=PDFCreator.Utilities"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance designTime:DesignTimeBusinessFeaturesInteractionViewModel}"
        d:DesignHeight="498"
        d:DesignWidth="610"
        Width="610"
        Height="498"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/DefaultsDictionary.xaml" />
                <ResourceDictionary Source="../../Styles/ColorDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border CornerRadius="12"
            BorderBrush="{StaticResource BusinessEditionViewBorderBrush}"      
            BorderThickness="1"
            Background="{StaticResource WhiteBrush}">

        <Border.Effect>
            <DropShadowEffect Color="{StaticResource BusinessEditionViewBorderEffect}"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.4" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!--Left side-->
            <Border Grid.Column="0"
                    Background="{StaticResource BusinessEditionLeftSideBorderBackgroundBrush}"
                    ClipToBounds="True">
                <Grid>
                    <Image Margin="0"
                           Source="../../Styles/Images/business_edition_left_side.png"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,40,20,0"
                              VerticalAlignment="Top">
                          
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource DescriptionTextBlock}"
                                       Text="{Binding Translation.LeftSideHeaderString}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BusinessEditionInteractionTextWhiteBrush}" />

                            <TextBlock Margin="0 16 0 0"
                                       Grid.Row="1"
                                       Style="{StaticResource DescriptionTextBlock}"
                                       Text="{Binding Translation.LeftSideDescription}"
                                       FontSize="14"
                                       Foreground="{StaticResource BusinessEditionInteractionTextWhiteBrush }"
                                       LineHeight="18" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right side -->

            <Grid Grid.Column="1"
                  Background="{StaticResource BusinessEditionViewGreyBackgroundBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Width="32"
                        Height="32"
                        Cursor="Hand"
                        FontSize="16"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Background="{StaticResource BusinessEditionViewGreyBackgroundBrush}"
                        Command="{Binding CloseWindowCommand}"
                        Style="{DynamicResource XButton}" />

                <!-- Header -->
                <Grid Margin="0 40 0 0"
                      Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Width="24"
                             Height="24"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0">
                        <ContentPresenter Content="{StaticResource BusinessEditionLightningIcon}" />
                    </Viewbox>

                    <TextBlock Grid.Column="1"
                               Grid.Row="0"
                               Style="{StaticResource DescriptionTextBlock}"
                               Text="{Binding Translation.RightSideHeader}"
                               FontSize="20"
                               FontWeight="Bold"/>


                </Grid>
                <!-- Features DataGrid/Table -->
                <Border Grid.Row="1"
                        Margin="32 24 32 0"
                        BorderBrush="{StaticResource BusinessEditionViewBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="1"
                        Height="306"
                        Width="306">
                    <DataGrid Height="306"
                              Width="306"
                              RowHeight="34"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="None"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="{StaticResource WhiteBrush}"
                              RowBackground="{StaticResource WhiteBrush}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              IsHitTestVisible="False"
                              HorizontalGridLinesBrush="{StaticResource BusinessEditionViewFeaturesTableLinesBrush}"
                              VerticalScrollBarVisibility="Disabled"
                              EnableRowVirtualization="False"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <!-- Checkmark column -->
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="✓"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Feature name column -->
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource DescriptionTextBlock}"
                                                   LineHeight="15"
                                                   VerticalAlignment="Center"
                                                   Margin="0,2,0, 0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Upgrade button -->
                <Button Grid.Row="2"
                        Style="{StaticResource LargeDefaultButton}"
                        Command="{Binding OpenUrlCommand}"
                        CommandParameter="{Binding Source={x:Static utilities:Urls.BusinessHintLink}}"
                        Margin="55,24,61,24"
                        Height="48"
                        Background="{StaticResource BusinessEditionOrangeBrush}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Viewbox Width="11"
                                 Height="16"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <ContentPresenter Content="{StaticResource BusinessEditionBlackLightningIcon}" />
                        </Viewbox>

                        <TextBlock Text="{Binding Translation.UpgradeNowButton}"
                                   Style="{StaticResource DescriptionTextBlock}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
