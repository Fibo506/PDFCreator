<UserControl x:Class="pdfforge.PDFCreator.UI.Presentation.Controls.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:pdfforge.PDFCreator.UI.Presentation.Controls"
             xmlns:workflow="clr-namespace:pdfforge.PDFCreator.Core.Workflow;assembly=PDFCreator.Workflow"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:converter="clr-namespace:pdfforge.PDFCreator.UI.Presentation.Converter"
             xmlns:designTime="clr-namespace:pdfforge.PDFCreator.UI.Presentation.DesignTime"
             x:Name="ThisPreviewControl"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance designTime:DesignTimePreviewControlViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/ColorDictionary.xaml" />
                <ResourceDictionary Source="../../Styles/DefaultsDictionary.xaml" />
                <ResourceDictionary Source="../../Styles/ListBox.xaml" />
                <ResourceDictionary Source="../../Styles/HoverBorder.xaml" />
                <ResourceDictionary Source="../../Styles/DragDropBorder.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:BoolToVisibilityConverter x:Key="CollapsedIfFalse" TrueValue="Visible" FalseValue="Collapsed" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
            <Grid>
                <ListBox Name="PreviewListBox"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         VerticalAlignment="Stretch"
                         PreviewMouseWheel="PreviewListBox_OnPreviewMouseWheel"
                         Style="{StaticResource NoEffectsListBox}"
                         ItemsSource="{Binding PreviewPageViewModels}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                        <!-- Margin b -10 to compensate elements margin -->
                            <local:UniformWrapPanel Orientation="Horizontal"
                                            Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ActualWidth}"
                                            Margin="0 0 0 -10" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type workflow:PreviewPage}">
                            <local:PreviewPageControl DataContext="{Binding}"
                                              Margin="0 0 10 10" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <mah:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0 10 0 0"
                          Width="30" Height="30"
                          Visibility="{Binding IsPreviewLoading, Converter={StaticResource CollapsedIfFalse}}" />
            </Grid>
    </Grid>

</UserControl>
